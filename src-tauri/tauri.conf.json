{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codexs",
  "version": "0.3.1",
  "identifier": "com.codexs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codexs",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../scripts/": "scripts/"
    },
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "./entitlements/macos.plist",
      "infoPlist": "./Info.plist",
      "dmg": {
        "windowSize": {
          "width": 720,
          "height": 440
        }
      }
    }
  }
}
